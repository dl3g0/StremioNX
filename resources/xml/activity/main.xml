<brls:AppletFrame
        iconInterpolation="linear"
        headerHidden="true"
        footerHidden="false">
    <brls:Box
            axis="column"
            width="100%"
            height="100%">
        <AutoTabFrame
                id="main/tabFrame"
                grow="1"
                tabBackgroundColor="@theme/color/grey_1"
                tabItemActiveTextColor="@theme/color/tsvitch"
                disableNavigationDown="true"
                defaultTab="0"
                sidebarPosition="left">

            <Tab label=""
                 fontSize="18"
                 icon="@res/png/ico-home.png"
                 iconActivate="@res/png/ico-home-activate.png">
                <CatalogTab/>
            </Tab>

            <Tab label=""
                 fontSize="18"
                 icon="@res/png/ico-search.png"
                 iconActivate="@res/png/ico-search-activate.png">
                <SearchTab/>
            </Tab>

            <Tab label=""
                 fontSize="18"
                 icon="@res/png/ico-setting.png"
                 iconActivate="@res/png/ico-setting.png">
                <SettingsTab/>
            </Tab>

        </AutoTabFrame>
    </brls:Box>
</brls:AppletFrame>
